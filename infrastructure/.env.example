# ============================================================
# 春连鲜选 (chunlian-fresh) —— 环境变量模板
#
# 来源：docs/DEPLOYMENT.md §5
#
# 用法：
#   cp infrastructure/.env.example infrastructure/.env
#   填入真实值后： set -a; . infrastructure/.env; set +a
#
# ⚠️  真实 .env 绝不提交 Git，绝不嵌入小程序或 APK。
#     本文件仅含占位值和默认值。
# ============================================================

# ------------------------------------------------------------
# 运行环境
# ------------------------------------------------------------
APP_ENV=dev
APP_URL=https://api.example.cn
BUSINESS_TIMEZONE=Asia/Shanghai

# ------------------------------------------------------------
# 数据库（仅内网/本机监听，3306 不对公网放行）
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chunlian_shop
DB_USER=chunlian
DB_PASS=__CHANGE_ME__
DB_PREFIX=shopxo_

# ------------------------------------------------------------
# 微信支付商户配置（仅保存在服务器安全配置中）
# ------------------------------------------------------------
WXPAY_MCHID=__CHANGE_ME__
WXPAY_SERIAL_NO=__CHANGE_ME__
WXPAY_PRIVATE_KEY_PATH=/etc/chunlian/apiclient_key.pem
WXPAY_APIV3_KEY=__CHANGE_ME__
WXPAY_NOTIFY_URL=https://api.example.cn/api/v1/webhook/wechatpay/notify

# ------------------------------------------------------------
# 商家 API
# ------------------------------------------------------------
MERCHANT_API_SECRET=__CHANGE_ME__
MERCHANT_TOKEN_TTL=7200
MERCHANT_REFRESH_TTL=2592000

# ------------------------------------------------------------
# 业务参数（见 config/extension.php）
# ------------------------------------------------------------
# 旧 SKU 是否维持原下单单价（全系统必须统一）
KEEP_ORIGINAL_UNIT_PRICE=true
# 预约送达最小前置缓冲（分钟）
MIN_LEAD_MINUTES=30
# 统一配送费（分），0 = 免运费
DELIVERY_FEE_FEN=0
# 待补款修订过期（分钟）
PENDING_TOPUP_TTL_MINUTES=30

# ------------------------------------------------------------
# 幂等与异步任务
# ------------------------------------------------------------
IDEMPOTENCY_TTL=86400
OUTBOX_MAX_RETRY=8

# ------------------------------------------------------------
# 上传
# ------------------------------------------------------------
UPLOAD_MAX_MB=5
